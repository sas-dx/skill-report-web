# 要求仕様ID: PLT.1-ENV.1 - 本番環境変数設定
# このファイルを .env にコピーして、実際の値を設定してください

# ========================================
# データベース設定（必須）
# ========================================
DATABASE_URL="postgresql://username:password@postgres:5432/skill_report_db"

# Docker Compose使用時のデータベース設定
DB_NAME="skill_report_db"
DB_USER="skill_user"
DB_PASSWORD="your-secure-password-here"

# ========================================
# Next.js / NextAuth設定（必須）
# ========================================
NEXTAUTH_URL="https://your-domain.com"
NEXTAUTH_SECRET="your-nextauth-secret-minimum-32-characters-long"

# ========================================
# JWT設定（必須）
# ========================================
JWT_SECRET="your-jwt-secret-minimum-32-characters-long"

# ========================================
# 暗号化設定（必須）
# ========================================
ENCRYPTION_KEY="your-32-character-encryption-key"

# ========================================
# メール設定（通知機能を使用する場合）
# ========================================
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_USER="your-email@example.com"
SMTP_PASS="your-email-password"
SMTP_FROM="noreply@example.com"

# ========================================
# 外部API設定（オプション）
# ========================================
# 人事システム連携
# HR_SYSTEM_API_URL="https://hr-api.example.com"
# HR_SYSTEM_API_KEY="your-hr-api-key"

# SSO設定
# SSO_PROVIDER_URL="https://sso.example.com"
# SSO_CLIENT_ID="your-sso-client-id"
# SSO_CLIENT_SECRET="your-sso-client-secret"

# ========================================
# ファイルアップロード設定
# ========================================
UPLOAD_MAX_SIZE="10485760"
UPLOAD_ALLOWED_TYPES="image/jpeg,image/png,application/pdf,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet"

# ========================================
# ログ設定
# ========================================
LOG_LEVEL="info"
LOG_FILE_PATH="./logs"

# ========================================
# セキュリティ設定
# ========================================
BCRYPT_ROUNDS="12"
SESSION_TIMEOUT="3600"

# ========================================
# アプリケーション設定
# ========================================
NODE_ENV="production"
PORT="3000"

# ========================================
# 監視・分析設定（オプション）
# ========================================
# SENTRY_DSN="your-sentry-dsn"
# GOOGLE_ANALYTICS_ID="your-ga-id"

# ========================================
# バックアップ設定（オプション）
# ========================================
# BACKUP_SCHEDULE="0 2 * * *"
# BACKUP_RETENTION_DAYS="30"

# ========================================
# Redis設定（キャッシュ・セッション管理に使用する場合）
# ========================================
# REDIS_URL="redis://redis:6379"

# ========================================
# 重要な注意事項
# ========================================
# 1. このファイルは .gitignore に含まれています
# 2. すべてのシークレットは強固なランダム文字列を使用してください
# 3. 本番環境では必ずHTTPSを使用してください
# 4. DATABASE_URLには実際のデータベース接続情報を設定してください
