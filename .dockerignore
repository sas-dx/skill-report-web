# 要求仕様ID: PLT.1-DOCKER.1 - 開発環境Docker化

# Node.js
node_modules
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.npm
.yarn-integrity

# Next.js（ビルド前のキャッシュのみ除外、ビルド後は必要）
.next/cache
out/

# Environment files（ビルド時は.env.exampleを参照）
.env.local
.env.development.local
.env.test.local

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Git
.git
.gitignore
.github/

# Documentation（ビルドに不要）
docs/
README.md
CHANGELOG.md
CONTRIBUTING.md
LICENSE.md

# Testing（本番ビルドに不要）
test/
tests/
coverage/
.nyc_output
*.test.ts
*.test.tsx
*.test.js
*.spec.ts
*.spec.tsx
*.spec.js

# Logs
logs
*.log

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Optional cache
.eslintcache
.rpt2_cache/
.rts2_cache_cjs/
.rts2_cache_es/
.rts2_cache_umd/
.cache
.parcel-cache

# Optional REPL history
.node_repl_history

# Output of 'npm pack'
*.tgz

# その他のビルド出力
.nuxt
.vuepress/dist
.serverless
.fusebox/
.dynamodb/
.tern-port
.vscode-test

# CI/CD固有のファイル（ローカルビルドには不要）
.gitlab-ci.yml
azure-pipelines.yml
bitbucket-pipelines.yml
