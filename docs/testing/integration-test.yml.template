# 統合テスト自動実行ワークフロー
# テスト計画書 6.3節に基づく実装

name: Integration Tests

on:
  push:
    branches:
      - main
      - develop
      - 'claude/**'
  pull_request:
    branches:
      - main
      - develop

env:
  NODE_VERSION: '18'
  POSTGRES_VERSION: '15-alpine'

jobs:
  integration-test:
    name: Integration Tests (Jest + Prisma + PostgreSQL)
    runs-on: ubuntu-latest
    timeout-minutes: 30

    services:
      postgres:
        image: postgres:15-alpine
        env:
          POSTGRES_DB: skill_report_test_db
          POSTGRES_USER: test_user
          POSTGRES_PASSWORD: test_password
          POSTGRES_INITDB_ARGS: '--encoding=UTF-8 --locale=C'
        options: >-
          --health-cmd "pg_isready -U test_user -d skill_report_test_db"
          --health-interval 10s
          --health-timeout 5s
          --health-retries 5
        ports:
          - 5434:5432

    steps:
      - name: Checkout code
        uses: actions/checkout@v4

      - name: Setup Node.js ${{ env.NODE_VERSION }}
        uses: actions/setup-node@v4
        with:
          node-version: ${{ env.NODE_VERSION }}
          cache: 'npm'

      - name: Install dependencies
        run: npm ci

      - name: Generate Prisma Client
        run: npx prisma generate --schema=src/database/prisma/schema.prisma

      - name: Run database migrations
        run: npx prisma migrate deploy --schema=src/database/prisma/schema.prisma
        env:
          DATABASE_URL: postgresql://test_user:test_password@localhost:5434/skill_report_test_db

      - name: Verify database connection
        run: |
          npx prisma db execute --schema=src/database/prisma/schema.prisma --stdin <<EOF
          SELECT 1 as connection_test;
          EOF
        env:
          DATABASE_URL: postgresql://test_user:test_password@localhost:5434/skill_report_test_db

      - name: Run integration tests
        run: npm run test:integration
        env:
          TEST_DATABASE_URL: postgresql://test_user:test_password@localhost:5434/skill_report_test_db
          JWT_SECRET: test-secret-key-for-ci
          JWT_EXPIRES_IN: 1h
          NODE_ENV: test

      - name: Generate test coverage report
        if: always()
        run: npm run test:integration:coverage
        env:
          TEST_DATABASE_URL: postgresql://test_user:test_password@localhost:5434/skill_report_test_db
          JWT_SECRET: test-secret-key-for-ci
          JWT_EXPIRES_IN: 1h
          NODE_ENV: test

      - name: Upload coverage to Codecov
        if: always()
        uses: codecov/codecov-action@v4
        with:
          files: ./coverage/lcov.info
          flags: integration
          name: integration-tests
          fail_ci_if_error: false

      - name: Upload test results
        if: always()
        uses: actions/upload-artifact@v4
        with:
          name: integration-test-results
          path: |
            coverage/
            test-results/
          retention-days: 30

      - name: Comment PR with test results
        if: github.event_name == 'pull_request' && always()
        uses: actions/github-script@v7
        with:
          script: |
            const fs = require('fs');
            const coveragePath = 'coverage/coverage-summary.json';

            if (fs.existsSync(coveragePath)) {
              const coverage = JSON.parse(fs.readFileSync(coveragePath, 'utf8'));
              const total = coverage.total;

              const comment = `## 📊 Integration Test Results

              | Metric | Coverage | Status |
              |--------|----------|--------|
              | Lines | ${total.lines.pct}% | ${total.lines.pct >= 80 ? '✅' : '⚠️'} |
              | Statements | ${total.statements.pct}% | ${total.statements.pct >= 80 ? '✅' : '⚠️'} |
              | Functions | ${total.functions.pct}% | ${total.functions.pct >= 80 ? '✅' : '⚠️'} |
              | Branches | ${total.branches.pct}% | ${total.branches.pct >= 80 ? '✅' : '⚠️'} |

              **Target**: 80% coverage for integration tests
              `;

              github.rest.issues.createComment({
                issue_number: context.issue.number,
                owner: context.repo.owner,
                repo: context.repo.repo,
                body: comment
              });
            }

  database-test:
    name: Database Integration Tests
    runs-on: ubuntu-latest
    timeout-minutes: 20

    services:
      postgres:
        image: postgres:15-alpine
        env:
          POSTGRES_DB: skill_report_test_db
          POSTGRES_USER: test_user
          POSTGRES_PASSWORD: test_password
        options: >-
          --health-cmd "pg_isready -U test_user -d skill_report_test_db"
          --health-interval 10s
          --health-timeout 5s
          --health-retries 5
        ports:
          - 5434:5432

    steps:
      - name: Checkout code
        uses: actions/checkout@v4

      - name: Setup Node.js ${{ env.NODE_VERSION }}
        uses: actions/setup-node@v4
        with:
          node-version: ${{ env.NODE_VERSION }}
          cache: 'npm'

      - name: Install dependencies
        run: npm ci

      - name: Generate Prisma Client
        run: npx prisma generate --schema=src/database/prisma/schema.prisma

      - name: Run database migrations
        run: npx prisma migrate deploy --schema=src/database/prisma/schema.prisma
        env:
          DATABASE_URL: postgresql://test_user:test_password@localhost:5434/skill_report_test_db

      - name: Run database-specific tests
        run: npm run test:integration:db
        env:
          TEST_DATABASE_URL: postgresql://test_user:test_password@localhost:5434/skill_report_test_db
          JWT_SECRET: test-secret-key-for-ci
          NODE_ENV: test

      - name: Upload database test results
        if: always()
        uses: actions/upload-artifact@v4
        with:
          name: database-test-results
          path: test-results/
          retention-days: 30

  quality-gate:
    name: Quality Gate Check
    runs-on: ubuntu-latest
    needs: [integration-test, database-test]
    if: always()

    steps:
      - name: Check test results
        run: |
          if [ "${{ needs.integration-test.result }}" != "success" ] || [ "${{ needs.database-test.result }}" != "success" ]; then
            echo "❌ Quality gate failed: Tests did not pass"
            exit 1
          fi
          echo "✅ Quality gate passed: All tests successful"

      - name: Quality gate summary
        run: |
          echo "## Quality Gate Results" >> $GITHUB_STEP_SUMMARY
          echo "" >> $GITHUB_STEP_SUMMARY
          echo "| Test Suite | Status |" >> $GITHUB_STEP_SUMMARY
          echo "|------------|--------|" >> $GITHUB_STEP_SUMMARY
          echo "| Integration Tests | ${{ needs.integration-test.result == 'success' && '✅ Passed' || '❌ Failed' }} |" >> $GITHUB_STEP_SUMMARY
          echo "| Database Tests | ${{ needs.database-test.result == 'success' && '✅ Passed' || '❌ Failed' }} |" >> $GITHUB_STEP_SUMMARY
          echo "" >> $GITHUB_STEP_SUMMARY
          echo "**Overall Status**: ${{ needs.integration-test.result == 'success' && needs.database-test.result == 'success' && '✅ All Passed' || '❌ Some Failed' }}" >> $GITHUB_STEP_SUMMARY
